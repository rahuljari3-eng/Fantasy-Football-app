{
  // Type-checks Roster Sensei's server (server/, api/, scripts/) and every
  // src/ module it imports. Part of `tsc -b` (see tsconfig.json) so a broken
  // server import or tool call fails the build instead of shipping -- both
  // the missing lib/coachTrades.ts and the missing-Pricer crashes did.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "api", "scripts"]
}
